#!/bin/sh
# /init do initramfs do rootfs limpo do Zeebo (build em /work/rootfs no container).
#
# O shell roda no console de VT (tty0) e nao na serial: e' o console de VT que o
# fbcon desenha na memoria de framebuffer, entao o eco da digitacao e as respostas
# aparecem no painel do framebuffer da janela. O /vtbridge faz a ponte: le' os bytes
# que o host injeta na UART (ttyMSM2) e os joga na fila de entrada do tty0 com
# TIOCSTI. O console do kernel continua em ttyMSM2, entao o log tambem sai no painel
# da UART.
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev 2>/dev/null || true
echo "========================================"
echo "  ZEEBO LINUX CLEAN ROOTFS INITIALIZED  "
echo "========================================"
uname -a
/vtbridge &
sleep 1
echo "Prompting shell no console de VT (tty0)..."
exec /bin/sh </dev/tty0 >/dev/tty0 2>&1
